# Server Configuration
PORT=3000
DB_PATH=./data/inventory.db

# Wasabi S3 Configuration (for remote backups)
# Set WASABI_ENABLED=true to enable automatic backup uploads to Wasabi
WASABI_ENABLED=false
WASABI_ACCESS_KEY_ID=your_access_key_here
WASABI_SECRET_ACCESS_KEY=your_secret_key_here
WASABI_BUCKET_NAME=your_bucket_name_here
WASABI_REGION=us-east-1

# Wasabi backup retention (days) - backups older than this will be deleted
# Default: 14 days (2 weeks)
WASABI_RETENTION_DAYS=14

# Optional: Custom Wasabi endpoint (default: https://s3.{region}.wasabisys.com)
# WASABI_ENDPOINT=https://s3.us-east-1.wasabisys.com
